import type { FrameOption, ToolbarItem } from "../../lib/registry.ts";

// A frame's client-shareable configuration. Imported by BOTH frame.ts (for the
// registry, which the server reads) and the frame's island (which renders it).
// It cannot be passed from the route into the island as a prop: `options` may
// carry `validator`/`map` functions, which do not survive island prop
// serialization.

/** Mono wordmark in the header, the way framejs.io shows "js". */
export const wordmark = "__NAME__";

/**
 * Rendered by the shared Options panel.
 *
 * Fields travel together inside the `options` hash param by default. Mark one
 * `hashParam: true` to give it its own top-level param instead — for values
 * that are part of what the frame *is* rather than how it looks, the way
 * molstar's `pdbId` sits in the URL beside markdown's `md`.
 */
export const options: FrameOption[] = [];

/**
 * Plain header actions — external links and the like. Anything that *opens*
 * something is a panel instead: pass `panels` to FrameShell (see the markdown
 * frame's island) so it joins the one shared panel slot and the header's
 * single selection.
 */
export const toolbar: ToolbarItem[] = [];
