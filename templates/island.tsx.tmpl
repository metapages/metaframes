import { FrameShell } from "../../../components/FrameShell.tsx";
import { useMetaframeInputs } from "../../../lib/metaframe/useMetaframe.ts";
import { options } from "../options.ts";

export function Main({ helpUrl }: { helpUrl: string }) {
  const inputs = useMetaframeInputs();

  return (
    <FrameShell title="__NAME__" helpUrl={helpUrl} options={options}>
      <div class="h-full overflow-auto p-3">
        <pre class="text-sm whitespace-pre-wrap">
          {JSON.stringify(inputs, null, 2)}
        </pre>
      </div>
    </FrameShell>
  );
}
